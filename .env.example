# Token from @BotFather (create a NEW bot just for this, don't reuse your n8n bot)
BOT_TOKEN=

# Also delete "Name joined the group" messages? true / false
DELETE_JOIN=false

# Optional: only work in these groups (comma-separated). Leave empty to work in any group.
# Supergroup IDs start with -100. Send /chatid in the group to get its ID.
# If set, the bot automatically leaves any other group someone adds it to.
ALLOWED_CHAT_IDS=

# Timezone used in the log
TIMEZONE=Asia/Phnom_Penh
